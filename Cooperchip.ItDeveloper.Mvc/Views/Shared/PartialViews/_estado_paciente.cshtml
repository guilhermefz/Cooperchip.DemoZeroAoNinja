<div class="row">
    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
        @await Component.InvokeAsync("StatusPaciente", new { estado = "Crítico" })
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
        @await Component.InvokeAsync("StatusPaciente", new { estado = "Grave" })
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
        @await Component.InvokeAsync("StatusPaciente", new { estado = "Em Observação" })
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
        @await Component.InvokeAsync("StatusPaciente", new { estado = "Estável" })
    </div>
</div>
